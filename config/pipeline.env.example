# Copy to config/pipeline.env and edit. Every script sources this file
# (override with CONFIG=/path/to/file). It is plain bash.
#
# To analyse against two references (e.g. a female assembly for an XY test and
# a male assembly for a ZW test), keep two copies of this file with different
# REF and OUTDIR and run the pipeline once with each.

# ============================== Inputs ==============================
SAMPLES=config/samples.tsv          # sample <tab> sex(M/F) <tab> fq1 <tab> fq2
REF=/path/to/reference.fa           # alignment / SNP-calling reference (not gzipped)
OUTDIR=results

# ============================ Resources =============================
# Keep these modest on shared servers: variant calling with 60 threads made a
# 48-core server unresponsive.
THREADS=16
SORT_MEM=4G                         # samtools sort memory per thread
MAX_PARALLEL_SAMPLES=2              # freebayes samples run at the same time

# ========================= 01 Read processing =======================
MARK_DUPLICATES=0                   # 1 = also run GATK MarkDuplicatesSpark

# ========================= 02 Variant calling =======================
PLOIDY=4                            # 2 diploid, 4 tetraploid (use 4 if unsure in a mixed-ploidy species)
MIN_MAPQ=20
MIN_BASEQ=20
MIN_ALT_COUNT=4                     # freebayes -C

# ========================= 03 Merged VCF filter =====================
MIN_QUAL=30
MIN_DP=5

# Assembled chromosomes only; unplaced scaffolds are dropped from windows/plots
CHROM_REGEX='chr_?[0-9]+$'

# ============================== 04 findZX ===========================
# One run per entry: SYSTEM|REFERENCE.  SYSTEM = XY, ZW or SHUFFLED (XY with
# randomly reassigned sexes, a negative control).
FINDZX_RUNS=(
  "XY|/path/to/female_reference.fa"
  "ZW|/path/to/male_reference.fa"
  "SHUFFLED|/path/to/female_reference.fa"
)
FINDZX_CORES=16
FINDZX_CONDA_ENV=findZX             # conda env with findZX's Snakemake (empty = use current env)
FINDZX_BACKGROUND=1                 # 1 = start findZX runs with nohup and continue (they take days)
FINDZX_WINDOWS="[25000, 50000, 100000]"
FINDZX_CONDA_PREFIX="$HOME/snakemake_conda_store"

# ==================== 05 Sex-specific SNP windows ===================
WINDOW=100000
STEP=50000
# One run per entry: NAME|classifier options. Aim for a few hundred sites:
# 4 sites is too strict to see anything, tens of thousands is noise.
SNP_RUNS=(
  "relaxed|--min-called-males 6 --min-called-females 5 --min-alt-males 6 --min-alt-females 5 --max-alt-opposite 2"
  "strict|--min-called-males 7 --min-called-females 5 --min-alt-males 7 --min-alt-females 5 --max-alt-opposite 0"
  "dose1|--min-called-males 7 --min-called-females 5 --min-alt-males 7 --min-alt-females 5 --max-alt-opposite 1 --alt-dosage 1"
  "dose2|--min-called-males 7 --min-called-females 5 --min-alt-males 7 --min-alt-females 5 --max-alt-opposite 1 --alt-dosage 2"
)
RELAXED_RUN=relaxed                 # used to find candidates
STRICT_RUN=strict                   # used to validate them

# ================ 06/07 Candidate follow-up (set after 05) ==========
# Fill in after looking at the stage-05 plots and merged_candidate_intervals.tsv.
CANDIDATES=(
  # "chr_07:8200000-9000000"
)
FOCAL_SEX=M                         # M for an XY hypothesis, F for ZW
PERMUTATIONS=10000

# ========================= 08 Sex-specific k-mers ===================
K=31
KMER_MIN_COUNT=2                    # kmc -ci
KMER_SUBSAMPLE=200000
KMER_WINDOW=25000
KMER_STEP=5000
# MODE|min samples of the focal sex carrying the k-mer
KMER_RUNS=(
  "MSK|7"
  "FSK|6"
)
# Every assembly/haplotype to map k-mers to: TAG=fasta
KMER_REFS=(
  "F1=/path/to/female_h1.fa"
  "F2=/path/to/female_h2.fa"
  "M1=/path/to/male_h1.fa"
  "M2=/path/to/male_h2.fa"
)
# sed -E pattern=replacement that makes chromosome names comparable between
# haplotypes of the same assembly (stage 09). Leave empty if not needed.
KMER_NAME_NORMALISE='_H[12]_chr_=_chr_'

# ========================= 10 Assembly dotplots =====================
DOTPLOT_PAIRS=config/pairs.tsv      # ref.fa <tab> query.fa <tab> name
DOTPLOT_MIN_IDENTITY=95
DOTPLOT_MIN_LENGTH=1000
DOTPLOT_CHROMS=(                    # single-chromosome dotplots: PAIR|REFCHROM|QRYCHROM|label
  # "F1_vs_M1|F1_chr_08|M1_chr_08|chr8"
)
