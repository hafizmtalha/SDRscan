# Copy to config/pipeline.env and edit. Every script in scripts/ sources this
# file (override the location with CONFIG=/path/to/file).

# ---- Inputs ----
SAMPLES=config/samples.tsv          # sample <tab> sex(M/F) <tab> fq1 <tab> fq2
REF=/path/to/reference.fa           # reference used for alignment/SNP calling (not gzipped)
OUTDIR=results                      # all outputs go under here

# ---- Resources ----
# Keep these modest on shared servers: one variant-calling run with 60
# threads was enough to make a 48-core server unresponsive.
THREADS=16
SORT_MEM=4G                         # samtools sort memory per thread
MAX_PARALLEL_SAMPLES=2              # freebayes samples run at the same time

# ---- Read processing ----
MARK_DUPLICATES=0                   # 1 = run GATK MarkDuplicatesSpark after adding read groups

# ---- Variant calling ----
PLOIDY=4                            # freebayes -p ; 2 for diploids, 4 for autotetraploids
MIN_MAPQ=20
MIN_BASEQ=20
MIN_ALT_COUNT=4                     # freebayes -C

# ---- Merged VCF filtering ----
MIN_QUAL=30
MIN_DP=5

# ---- Sex-specific SNP windows ----
WINDOW=100000
STEP=50000
CHROM_REGEX='chr_?[0-9]+$'          # keep only assembled chromosomes (drop unplaced scaffolds)

# ---- k-mer analysis ----
K=31
KMER_MIN_COUNT=2                    # kmc -ci
KMER_SUBSAMPLE=200000               # sex-specific k-mers mapped back to each reference
KMER_WINDOW=25000
KMER_STEP=5000
